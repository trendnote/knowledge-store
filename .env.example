# ==============================================
# Knowledge Store - Environment Configuration
# ==============================================

# Application
APP_NAME=knowledge-store
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==============================================
# PostgreSQL Configuration
# ==============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_store
POSTGRES_USER=ks_user
POSTGRES_PASSWORD=ks_password
POSTGRES_POOL_SIZE=20
POSTGRES_POOL_MAX_OVERFLOW=10

# ==============================================
# Milvus Configuration
# ==============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_chunks

# ==============================================
# Neo4j Configuration
# ==============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# ==============================================
# Kafka Configuration
# ==============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=knowledge-store
KAFKA_TOPIC_DOCUMENTS=documents
KAFKA_TOPIC_SYNC=sync

# ==============================================
# Embedding Configuration
# ==============================================
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_USE_FP16=true
BGE_M3_BATCH_SIZE=32

# ==============================================
# API Configuration
# ==============================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
