# ==============================================
# Knowledge Store - Environment Configuration
# ==============================================
# Required fields are marked with [REQUIRED]

# Application
APP_NAME=knowledge-store
APP_ENV=development  # Options: development, staging, production
DEBUG=true

# ==============================================
# PostgreSQL Configuration
# ==============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_store
POSTGRES_USER=ks_user            # [REQUIRED]
POSTGRES_PASSWORD=ks_password    # [REQUIRED]
POSTGRES_POOL_SIZE=20            # Range: 1-100
POSTGRES_POOL_MAX_OVERFLOW=10    # Range: 0-50

# ==============================================
# Milvus Configuration
# ==============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_chunks

# ==============================================
# Neo4j Configuration
# ==============================================
NEO4J_URI=bolt://localhost:7687  # Must start with bolt:// or neo4j://
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password    # [REQUIRED]

# ==============================================
# Kafka Configuration
# ==============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092  # Comma-separated list for multiple servers
KAFKA_CONSUMER_GROUP=knowledge-store
KAFKA_TOPIC_DOCUMENTS=documents
KAFKA_TOPIC_SYNC=sync

# ==============================================
# Embedding Configuration (BGE-M3)
# ==============================================
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_USE_FP16=true
BGE_M3_BATCH_SIZE=32             # Range: 1-256

# ==============================================
# API Configuration
# ==============================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_CORS_ORIGINS=["http://localhost:3000"]

# ==============================================
# Logging Configuration
# ==============================================
LOG_LEVEL=INFO                   # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json
